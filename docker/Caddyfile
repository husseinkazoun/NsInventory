# Shared upstream definition. Caddy terminates TLS and is the ONLY legitimate
# proxy in front of the app, so it explicitly sets the forwarded headers to the
# real connection values — overwriting anything a client tried to spoof. Laravel
# trusts only the Docker subnet (TRUSTED_PROXIES), so these values are authoritative.
(app_upstream) {
	encode zstd gzip
	reverse_proxy app:80 {
		header_up X-Forwarded-Proto {http.request.scheme}
		header_up X-Forwarded-Host {http.request.host}
		header_up X-Forwarded-For {http.request.remote.host}
	}
}

# Primary domain: serve the Laravel app.
sanadinventory.com {
	import app_upstream
}

# www -> apex, permanent (301) redirect, preserving the request path/query.
www.sanadinventory.com {
	redir https://sanadinventory.com{uri} permanent
}

# VM-origin fallback hostname (35-225-78-186.sslip.io). Kept operational so the
# app stays reachable directly on the VM during and after the domain migration.
{$PUBLIC_HOST} {
	import app_upstream
}
