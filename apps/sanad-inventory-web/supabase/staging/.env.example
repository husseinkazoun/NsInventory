# =====================================================================
# Staging bootstrap environment — PLACEHOLDERS ONLY
# =====================================================================
# Copy to `.env.staging.local` (gitignored) and fill in real values.
# Never commit the filled-in file. Never paste the service-role key into
# chat, a ticket, or a screenshot.
#
#   cp supabase/staging/.env.example supabase/staging/.env.staging.local
#   set -a && . supabase/staging/.env.staging.local && set +a
#   npm run staging:bootstrap          # dry run
#   npm run staging:bootstrap -- --apply
# =====================================================================

# --- Target project (REQUIRED) ---------------------------------------
# The staging project's reference, 20 lowercase letters. Naming it explicitly
# is what stops the script running against something else: the URL below must
# contain this exact value.
SUPABASE_STAGING_PROJECT_REF=replace_with_staging_project_ref

# Staging project API URL. Must contain SUPABASE_STAGING_PROJECT_REF.
SUPABASE_STAGING_URL=https://replace_with_staging_project_ref.supabase.co

# --- Secret (REQUIRED) -----------------------------------------------
# Service-role key for the STAGING project only. Bypasses RLS entirely, so it
# is server-side only: never expose it to the browser and never commit it.
# Dashboard → Project Settings → API → service_role.
SUPABASE_STAGING_SERVICE_ROLE_KEY=replace_with_staging_service_role_key

# --- Fake accounts (REQUIRED) ----------------------------------------
# Shared password for the four staging accounts. Minimum 12 characters.
# These are throwaway test logins on a throwaway project — never reuse a real
# password here.
STAGING_USER_PASSWORD=replace_with_a_long_random_staging_password

# --- Safety rail (STRONGLY RECOMMENDED) ------------------------------
# Comma-separated project refs the scripts must NEVER touch. Put your
# production ref here. Left empty by default so no production identifier is
# committed to this repository.
SUPABASE_PRODUCTION_PROJECT_REFS=

# --- Explicit confirmation (REQUIRED) --------------------------------
# Acknowledges that running with --apply writes to a hosted project.
STAGING_BOOTSTRAP_CONFIRM=no

# --- Optional overrides ----------------------------------------------
# Reserved .invalid TLD (RFC 2606) so these addresses can never route.
# STAGING_EMAIL_DOMAIN=sanad-staging.invalid
# STAGING_ORG_SLUG=sanad-staging
