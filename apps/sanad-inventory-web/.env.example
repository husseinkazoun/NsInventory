# Sanad Inventory — local environment
#
# Copy this file to `.env.local` and fill in the values to enable Supabase
# authentication and storage.
#
# When both VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY are unset (or empty),
# the app runs in DEMO MODE:
#   - mock data renders everywhere
#   - the AuthGuard is bypassed
#   - the Header shows a placeholder "Admin" identity
# This keeps the prototype demoable on machines that don't have Supabase wired.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
